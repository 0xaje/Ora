# ==============================================================================
# ORA Architectural Intelligence — Environment Configuration
# ==============================================================================

# AssemblyAI API Key for Server-Side Ephemeral Token Minting (Phase 5A)
# SERVER-ONLY: Used exclusively by the server/Vite middleware to mint 60-second
# ephemeral tokens. NEVER prefix with VITE_ (must never be bundled into client).
# Required for live hands-free streaming speech-to-text. Requires internet access.
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# LLM Provider Configuration: "ollama" (local private) or "openrouter" (cloud API)
LLM_PROVIDER=ollama

# Local Ollama Configuration (Default for private, zero-cloud-fee execution)
# 1. Start Ollama on your machine (`ollama serve`).
# 2. Run `ollama list` in your terminal to see your installed models and exact tags.
# 3. Set OLLAMA_MODEL to match your installed model (e.g., qwen2.5:1.5b, qwen2.5:7b, etc.).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

# OpenRouter Alternative (Cloud LLM fallback requiring reviewer's own API key)
# Used when LLM_PROVIDER=openrouter, or as server failover if Ollama is unreachable.
# Server-only: never exposed to browser.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free



